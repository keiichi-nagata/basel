# コピーして .env を作る（.env はコミットされない）

# TMDB v4 Read Access Token — https://www.themoviedb.org/settings/api
TMDB_API_TOKEN=

# 任意: TVer 週間ランキングを自動取得する場合のみ。
# 未設定なら dev/3-drama/data/inputs/<week>.tver.json（手動入力）を使う。
TVER_RANKING_URL=

# OpenAI API（画像生成の自動化・scripts/ai_image.py で使用）
# https://platform.openai.com/settings/organization/billing で支払い方法を登録し、
# https://platform.openai.com/api-keys でキーを発行する。ChatGPT Plusとは別料金（従量課金）。
OPENAI_API_KEY=
# 任意: モデル名を上書きしたい場合のみ（未設定なら scripts/ai_image.py 内の既定値を使う）
OPENAI_IMAGE_MODEL=
